{
	"name": "proxy",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"setup": "node scripts/setup-ai.mjs",
		"dev": "bun run --filter './packages/*' dev",
		"build": "bun run --cwd packages/web build",
		"typecheck": "bun run --filter './packages/*' typecheck",
		"lint": "bun run --cwd packages/web lint",
		"test": "bun run --filter './packages/*' test"
	},
	"devDependencies": {
		"prettier": "^3.5.3"
	}
}
