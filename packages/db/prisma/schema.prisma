// Regenerate the client: bun run --cwd packages/db db:generate
// New migration: bun run --cwd packages/db db:migrate:diff, saved as prisma/migrations/<name>/migration.sql,
// the name `v` and the next three-digit number, such as v011_add_x (src/migrations.test.ts says why)
// Apply migrations: bun run --cwd packages/db db:migrate:deploy

generator client {
  provider = "prisma-client-js"
}

// No foreign keys in the database: Prisma checks relations and runs the cascades itself, so
// every relation column carries its own index.
datasource db {
  provider     = "postgres"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

// Values for the whole installation, such as telemetry's random instance id.
model InstanceMeta {
  key   String @id
  value String
}

model User {
  id              String    @id @default(cuid())
  name            String?
  email           String    @unique
  emailVerified   DateTime?
  image           String?
  // When they accepted the terms of service and the privacy policy, by signing up past the notice
  // on the sign-in page. None for an account from before the notice, until it is asked to accept.
  termsAcceptedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  accounts     Account[]
  sessions     Session[]
  orgMembers   OrgMember[]
  writeTargets WriteTarget[]
}

// A sign-in provider identity linked to a user, such as their Google account. Only who it is:
// signing in needs no tokens from the provider once the identity is known, so none are kept.
model Account {
  id                String @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// A signed-in browser. The session cookie holds a random token; only its hash is stored, as for
// agents' sessions, so a leaked table signs no one in.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expires   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A magic link waiting to be clicked. `token` is a hash, never the token from the email.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([identifier, token])
}

// Every user gets one organization at sign-up, for when data is shared between people. Nothing
// reads it yet.
model Organization {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  // When the welcome flow was finished or skipped; until then the web app shows it instead of the app.
  onboardedAt DateTime?
  // Experiments on for the organization, by id (EXPERIMENTS in @proxy/utils; an id no longer there
  // is ignored), and an insider has all of them. Both set from the internal admin, never in the app.
  experiments String[]  @default([])
  insider     Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  members     OrgMember[]
  connections Connection[]
  agents      Agent[]
  audit       AuditEntry[]
  feedback    AgentFeedback[]
  tasks       AgentTask[]
  threads     AgentThread[]
}

model OrgMember {
  id     String @id @default(cuid())
  orgId  String
  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([userId])
}

// A connected account of an integration from the catalog (`@proxy/integrations`), such as a
// mailbox. An organization can connect the same integration more than once. Every organization
// also has one built-in vault connection, made with it, whose entries live in Personal Agent Proxy.
model Connection {
  id                String  @id @default(cuid())
  orgId             String
  integrationId     String
  // The account as the provider names it, such as an email address; the organization's name for
  // the vault.
  account           String
  // The provider's own id for the account, which stays as its address changes: Google's `sub`.
  // None where the provider gives none, or for a connection from before it was kept.
  providerAccountId String?
  // Encrypted with ENCRYPTION_KEY: an app password with its server settings. None for the vault.
  credential        String?
  // A custom MCP server's tools as the server last listed them (`@proxy/integrations`' McpTool),
  // as JSON: what agents can be allowed with it. Null for every other integration.
  tools             String?
  // What the person called the connection, where they named it: a custom MCP server is named when
  // it is connected. Null for every other integration, which shows as its integration.
  name              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  org          Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  defaults     ConnectionDefault[]
  vaultEntries VaultEntry[]
  agentGrants  AgentGrant[]
  writeTargets WriteTarget[]

  @@index([orgId])
  @@index([integrationId, providerAccountId])
}

// Where the home page's widgets write when there is more than one place: the calendar a new event
// goes in, the mailbox an email goes out from. The last place each person wrote to, per
// collection; none until they first write, and gone with the connection.
model WriteTarget {
  id           String  @id @default(cuid())
  userId       String
  // The collection written to, as the catalog names it: `events`, `emails`.
  collectionId String
  connectionId String
  // Where in the connection, in a nested collection: a calendar's id.
  parent       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([userId, collectionId])
  @@index([connectionId])
}

// An action of the connection that agents get by default, such as `read` or `archive` on a
// mailbox. The actions are the catalog's (`@proxy/integrations`); no row is off.
model ConnectionDefault {
  id           String @id @default(cuid())
  connectionId String
  actionId     String

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, actionId])
}

// An entry of the built-in vault connection: a title, a type and its content.
model VaultEntry {
  id           String @id @default(cuid())
  connectionId String
  // `entries`, the vault's one collection.
  collectionId String
  // The title, the type and the content as JSON, encrypted with ENCRYPTION_KEY.
  values       String

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, collectionId])
}

// A login handed to an AI agent. The password is shown once, when it is made or reset; only its
// hash is kept.
model Agent {
  id           String    @id @default(cuid())
  orgId        String
  // One of the catalog's AGENT_PROVIDERS. A provider's login is named by the provider, so an
  // organization has one per provider; custom agents are named by the person, one per name.
  providerId   String
  name         String
  username     String    @unique
  passwordHash String
  lastActiveAt DateTime?
  revokedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  org         Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  grants      AgentGrant[]
  sessions    AgentSession[]
  oauthCodes  OAuthCode[]
  oauthGrants OAuthGrant[]

  @@unique([orgId, providerId, name])
  @@index([orgId])
}

// An agent's own setting for one action of a connection, on or off, where it differs from the
// connection's default. No row means the agent follows the default.
model AgentGrant {
  id           String  @id @default(cuid())
  agentId      String
  connectionId String
  actionId     String
  allowed      Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  agent      Agent      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([agentId, connectionId, actionId])
  @@index([connectionId])
}

// A signed-in agent. The agent's cookie holds a random token; only its hash is stored.
model AgentSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  agentId   String
  expires   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
}

enum AuditOutcome {
  allowed
  denied
}

// How an agent came in: the web app's agent pages, the MCP server, or the built-in agent's own
// loop (`harness`).
enum AuditVia {
  web
  mcp
  harness
}

// One request an agent made, allowed or denied, or one thing Personal Agent Proxy did itself for a
// person, as the home page's widgets write. Plain ids rather than relations, so the entry stays
// when the agent or the connection is gone.
model AuditEntry {
  id           String       @id @default(cuid())
  orgId        String
  // None for what Personal Agent Proxy did itself.
  agentId      String?
  connectionId String
  collectionId String
  // list, view, create, update or delete, or one of the collection's commands, such as `send`.
  action       String
  // The record's title at the time, for actions on one record.
  recordTitle  String?
  // What a list searched for.
  query        String?
  outcome      AuditOutcome
  via          AuditVia     @default(web)
  // The agent's task the request was made for (AgentTask); none for entries from before tasks,
  // and for what Personal Agent Proxy did itself.
  taskId       String?

  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([taskId])
}

// What an agent set out to do with Personal Agent Proxy: an agent starts a task, naming it and
// saying what the person asked for, makes its requests for it, each logged with the task, and
// finishes it. Plain ids, like the activity log, so it stays when the agent is gone.
model AgentTask {
  id         String    @id @default(cuid())
  orgId      String
  agentId    String
  // A few words, as a heading.
  title      String
  // What the person asked for, in a sentence or two.
  goal       String
  via        AuditVia
  // Set once the agent calls the task finished; null while it is under way.
  finishedAt DateTime?

  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([agentId])
}

// What an agent told the makers of Personal Agent Proxy, such as a tool that didn't work as it
// expected: sent with the MCP server's send_feedback or the agent pages' feedback form, and read
// by us, never shown in the app. Plain ids, like the activity log, so it stays when the agent or
// the connection is gone; it goes with the organization.
model AgentFeedback {
  id           String   @id @default(cuid())
  orgId        String
  agentId      String
  // The agent's AGENT_PROVIDERS id, such as `claude`, kept beside the login it came from.
  providerId   String
  message      String
  // The connection and the tool it is about, where the agent named them.
  connectionId String?
  tool         String?
  via          AuditVia
  // The task the agent was on, where it named one.
  taskId       String?

  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([createdAt])
}

// An MCP client that registered itself to sign agents in, such as Claude or ChatGPT (OAuth
// Dynamic Client Registration). Anyone can register one; it gets nothing until a person signs in
// and lets it work as one of their agents. One that hasn't finished a sign-in a day after
// registering is deleted by the next registration.
model OAuthClient {
  // The client_id it signs in with.
  id           String    @id
  name         String
  redirectUris String[]
  // Only for a client that signs in with a secret; others have PKCE alone.
  secretHash   String?
  // When it first traded a code for tokens; kept for good once set.
  usedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  codes  OAuthCode[]
  grants OAuthGrant[]

  @@index([createdAt])
}

// A code a client exchanges once for tokens, within minutes, with its PKCE verifier. Only its
// SHA-256 is kept.
model OAuthCode {
  id            String   @id @default(cuid())
  codeHash      String   @unique
  clientId      String
  agentId       String
  redirectUri   String
  codeChallenge String
  expires       DateTime

  createdAt DateTime @default(now())

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  agent  Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([agentId])
}

// A client signed in as an agent: its access token and refresh token, by their SHA-256.
// Refreshing replaces both. Disconnecting it, or revoking or deleting the agent, ends it.
model OAuthGrant {
  id               String   @id @default(cuid())
  clientId         String
  agentId          String
  accessTokenHash  String   @unique
  accessExpires    DateTime
  refreshTokenHash String   @unique
  refreshExpires   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  agent  Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([agentId])
}

// The built-in agent's conversation with a person: one thread, holding its log of entries. Every
// call made in it is for the thread's task, as any agent's calls are; a task abandoned a day on is
// replaced by a new one. Everything that happens to the agent is an entry, and everything that
// makes it do something is a job (AgentJob).
model AgentThread {
  id      String @id @default(cuid())
  orgId   String
  // The built-in agent of the organization, an Agent like any other, with grants of its own.
  agentId String
  taskId  String

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  entries AgentEntry[]
  jobs    AgentJob[]

  @@index([orgId, createdAt])
}

// What an entry of a thread's log is: what the person said, what the model answered, with the tool
// calls it made, or what one of those calls answered.
enum AgentEntryKind {
  person
  assistant
  tool_result
}

// One entry of a thread's log, in the order of `seq`. The log is the transcript the model reads:
// an assistant entry carries its tool calls, and each gets a tool_result entry once run.
model AgentEntry {
  id       String         @id @default(cuid())
  seq      Int            @unique @default(autoincrement())
  threadId String
  kind     AgentEntryKind
  // What the person said, what the model said (maybe nothing beside its calls), or what a call
  // answered.
  text     String
  // An assistant entry's tool calls as JSON (`@proxy/utils/harness` ToolCall[]); null otherwise.
  toolCalls String?
  // A tool_result entry's call, by the id the model gave it; null otherwise.
  callId   String?
  // A tool_result that is an error, in words the model can act on.
  isError  Boolean        @default(false)
  // An assistant entry's cost.
  inputTokens  Int?
  outputTokens Int?

  createdAt DateTime @default(now())

  thread AgentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, seq])
}

enum AgentJobKind {
  inference
  tool
}

enum AgentJobStatus {
  queued
  running
  done
  failed
}

// A unit of the built-in agent's work, claimed by one api instance at a time: run the model on a
// thread's log (inference), or run one tool call of an assistant entry (tool). `runAt` is when it
// may run, which is how a call to sleep is kept. A worker claims a job due with a lease, renews
// the lease while it works, and finishes the job in the same transaction as the entries it writes,
// only while it still holds the lease; a lease that runs out gives the job to the next worker.
model AgentJob {
  id       String         @id @default(cuid())
  threadId String
  kind     AgentJobKind
  status   AgentJobStatus @default(queued)
  // A tool job's call: the assistant entry it is in and the id the model gave it.
  entryId  String?
  callId   String?
  runAt    DateTime       @default(now())
  // Which worker holds it, and until when, while it is running.
  claimedBy      String?
  leaseExpiresAt DateTime?
  attempts       Int       @default(0)
  // Why it failed, where it did.
  error    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  thread AgentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([entryId, callId])
  @@index([status, runAt])
  @@index([threadId])
}
