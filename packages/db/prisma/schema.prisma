// Regenerate the client: bun run --cwd packages/db db:generate
// New migration: bun run --cwd packages/db db:migrate:diff, saved as prisma/migrations/<name>/migration.sql
// Apply migrations: bun run --cwd packages/db db:migrate:deploy

generator client {
  provider = "prisma-client-js"
}

// No foreign keys in the database: Prisma checks relations and runs the cascades itself, so
// every relation column carries its own index.
datasource db {
  provider     = "postgres"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  accounts   Account[]
  sessions   Session[]
  orgMembers OrgMember[]
}

// A sign-in provider identity linked to a user, such as their Google account.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// A signed-in browser. The session cookie holds `sessionToken`.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A magic link waiting to be clicked. `token` is a hash, never the token from the email.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([identifier, token])
}

// Every user gets one organization at sign-up, for when data is shared between people. Nothing
// reads it yet.
model Organization {
  id   String @id @default(cuid())
  name String
  slug String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  members     OrgMember[]
  connections Connection[]
}

model OrgMember {
  id     String @id @default(cuid())
  orgId  String
  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([userId])
}

enum Access {
  none
  read
  write
}

// A connected account of an integration from the catalog (`@proxy/integrations`), such as a
// mailbox or a Google account. An organization can connect the same integration more than once.
model Connection {
  id            String   @id @default(cuid())
  orgId         String
  integrationId String
  // The account as the provider names it, such as an email address.
  account       String
  // Encrypted with ENCRYPTION_KEY: an app password with its server settings.
  credential    String

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  org      Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  defaults ConnectionDefault[]

  @@index([orgId])
}

// What an agent without a setting of its own can do in one of the connection's collections. No
// row is no access.
model ConnectionDefault {
  id           String @id @default(cuid())
  connectionId String
  collectionId String
  access       Access

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, collectionId])
}
