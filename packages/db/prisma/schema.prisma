// Regenerate the client: bun run --cwd packages/db db:generate
// New migration: bun run --cwd packages/db db:migrate:diff, saved as prisma/migrations/<name>/migration.sql,
// the name `v` and the next three-digit number, such as v011_add_x (src/migrations.test.ts says why)
// Apply migrations: bun run --cwd packages/db db:migrate:deploy

generator client {
  provider = "prisma-client-js"
}

// No foreign keys in the database: Prisma checks relations and runs the cascades itself, so
// every relation column carries its own index.
datasource db {
  provider     = "postgres"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

// Values for the whole installation, such as telemetry's random instance id.
model InstanceMeta {
  key   String @id
  value String
}

model User {
  id              String    @id @default(cuid())
  name            String?
  email           String    @unique
  emailVerified   DateTime?
  image           String?
  // When they accepted the terms of service and the privacy policy, by signing up past the notice
  // on the sign-in page. None for an account from before the notice, until it is asked to accept.
  termsAcceptedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  accounts     Account[]
  sessions     Session[]
  orgMembers   OrgMember[]
  ownedOrgs    Organization[]
  connections  Connection[]
  agents       Agent[]
  writeTargets WriteTarget[]
}

// A sign-in provider identity linked to a user, such as their Google account. Only who it is:
// signing in needs no tokens from the provider once the identity is known, so none are kept.
model Account {
  id                String @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// A signed-in browser. The session cookie holds a random token; only its hash is stored, as for
// agents' sessions, so a leaked table signs no one in.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expires   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A magic link waiting to be clicked. `token` is a hash, never the token from the email.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([identifier, token])
}

// People working together: every user gets one at sign-up and can make more or be invited into
// others'. Each has one owner, whoever made it, for good, who is also one of its members; it goes
// with their account, and the last one they own can't go before it, so everyone owns one. Its
// `slug` is its address in the web app and the api (`/acme/connections`, `/api/orgs/acme/…`),
// fixed when it is made.
model Organization {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  ownerUserId String
  // When the welcome flow was finished or skipped; until then the web app shows it instead of the app.
  onboardedAt DateTime?
  // Experiments on for the organization, by id (EXPERIMENTS in @proxy/utils; an id no longer there
  // is ignored), and an insider has all of them. Both set from the internal admin, never in the app.
  experiments String[]  @default([])
  insider     Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  owner       User            @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  members     OrgMember[]
  invitations Invitation[]
  connections Connection[]
  agents      Agent[]
  audit       AuditEntry[]
  feedback    AgentFeedback[]
  tasks       AgentTask[]

  @@index([ownerUserId])
}

// A person in an organization: its owner (`Organization.ownerUserId`), who renames and deletes
// it, invites people and removes members, or anyone else, who can leave.
model OrgMember {
  id     String @id @default(cuid())
  orgId  String
  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([orgId])
  @@index([userId])
}

// Someone asked into an organization by email: the link sent them signs them in or up and makes
// them a member. Only the token's SHA-256 is kept; taking it up deletes it.
model Invitation {
  id          String   @id @default(cuid())
  orgId       String
  email       String
  tokenHash   String   @unique
  // A plain id: the invitation stays when whoever sent it is gone.
  invitedById String
  expires     DateTime

  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

// A connected account of an integration from the catalog (`@proxy/integrations`), such as a
// mailbox. An organization can connect the same integration more than once. A connection is either
// one member's, which nobody else in the organization sees, or shared with every member of it; one
// that is shared stays shared. Every member also has their own built-in vault connection in each
// organization, made when they join it, whose entries live in Personal Agent Proxy.
model Connection {
  id                String  @id @default(cuid())
  orgId             String
  integrationId     String
  // The account as the provider names it, such as an email address; the organization's name for
  // the vault.
  account           String
  // The provider's own id for the account, which stays as its address changes: Google's `sub`.
  // None where the provider gives none, or for a connection from before it was kept.
  providerAccountId String?
  // Encrypted with ENCRYPTION_KEY: an app password with its server settings. None for the vault.
  credential        String?
  // A custom MCP server's tools as the server last listed them (`@proxy/integrations`' McpTool),
  // as JSON: what agents can be allowed with it. Null for every other integration.
  tools             String?
  // What the person called the connection, where they named it: a custom MCP server is named when
  // it is connected. Null for every other integration, which shows as its integration.
  name              String?
  // The member whose connection it is, which nobody else in the organization sees; null for one
  // shared with every member of it.
  ownerUserId       String?
  // Who connected it, kept once it is shared: who a sign-in acts as, and who may change it beside
  // the organization's owner. A plain id rather than a relation, so a shared connection stays when
  // they are gone.
  connectedById     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  org          Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  owner        User?               @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  defaults     ConnectionDefault[]
  vaultEntries VaultEntry[]
  agentGrants  AgentGrant[]
  writeTargets WriteTarget[]

  @@index([orgId])
  @@index([ownerUserId])
  @@index([integrationId, providerAccountId])
}

// Where the home page's widgets write when there is more than one place: the calendar a new event
// goes in, the mailbox an email goes out from. The last place each person wrote to, per
// collection; none until they first write, and gone with the connection.
model WriteTarget {
  id           String  @id @default(cuid())
  userId       String
  // The collection written to, as the catalog names it: `events`, `emails`.
  collectionId String
  connectionId String
  // Where in the connection, in a nested collection: a calendar's id.
  parent       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([userId, collectionId])
  @@index([connectionId])
}

// An action of the connection that agents get by default, such as `read` or `archive` on a
// mailbox. The actions are the catalog's (`@proxy/integrations`); no row is off.
model ConnectionDefault {
  id           String @id @default(cuid())
  connectionId String
  actionId     String

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, actionId])
}

// An entry of the built-in vault connection: a title, a type and its content.
model VaultEntry {
  id           String @id @default(cuid())
  connectionId String
  // `entries`, the vault's one collection.
  collectionId String
  // The title, the type and the content as JSON, encrypted with ENCRYPTION_KEY.
  values       String

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, collectionId])
}

// A login handed to an AI agent, in one organization: a member's own, which reaches the
// organization's shared connections and that member's own, or shared with every member of it,
// which reaches the shared connections alone; one that is shared stays shared. The password is
// shown once, when it is made or reset; only its hash is kept.
model Agent {
  id           String    @id @default(cuid())
  orgId        String
  // One of the catalog's AGENT_PROVIDERS, of which there can be any number of logins, each named by
  // the person or after the provider.
  providerId   String
  name         String
  username     String    @unique
  passwordHash String
  lastActiveAt DateTime?
  revokedAt    DateTime?
  // The member whose agent it is, which nobody else in the organization sees; null for one shared
  // with every member of it.
  ownerUserId  String?
  // Who made it, kept once it is shared: who may change it beside the organization's owner. A plain
  // id rather than a relation, so a shared agent stays when they are gone.
  createdById  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  org         Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  owner       User?          @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  grants      AgentGrant[]
  sessions    AgentSession[]
  oauthCodes  OAuthCode[]
  oauthGrants OAuthGrant[]

  @@index([orgId])
  @@index([ownerUserId])
}

// An agent's own setting for one action of a connection, on or off, where it differs from the
// connection's default. No row means the agent follows the default.
model AgentGrant {
  id           String  @id @default(cuid())
  agentId      String
  connectionId String
  actionId     String
  allowed      Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  agent      Agent      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([agentId, connectionId, actionId])
  @@index([connectionId])
}

// A signed-in agent. The agent's cookie holds a random token; only its hash is stored.
model AgentSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  agentId   String
  expires   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
}

// Allowed and done, refused by the agent's access, or allowed but failed: the provider turned it
// down, or couldn't be reached.
enum AuditOutcome {
  allowed
  denied
  failed
}

// How an agent came in: the web app's agent pages, or the MCP server.
enum AuditVia {
  web
  mcp
}

// One request an agent made, allowed, denied or failed, or one thing Personal Agent Proxy did
// itself for a person, as the home page's widgets write. Plain ids rather than relations, so the
// entry stays when the agent or the connection is gone.
model AuditEntry {
  id           String       @id @default(cuid())
  orgId        String
  // None for what Personal Agent Proxy did itself.
  agentId      String?
  connectionId String
  collectionId String
  // list, view, create, update or delete, or one of the collection's commands, such as `send`.
  action       String
  // The record's title at the time, for actions on one record.
  recordTitle  String?
  // What a list searched for.
  query        String?
  outcome      AuditOutcome
  via          AuditVia     @default(web)
  // The agent's task the request was made for (AgentTask); none for entries from before tasks,
  // and for what Personal Agent Proxy did itself.
  taskId       String?
  // How long the request took to run, from when it came in to when it was logged, as it was for
  // every entry logged since this was kept; none for the entries from before, and for what
  // Personal Agent Proxy did itself.
  durationMs   Int?
  // Whose log it is: the member whose own the agent is, or whose own the connection was for what
  // Personal Agent Proxy did itself; null for a shared agent's or a shared connection's, which
  // everyone in the organization sees.
  ownerUserId  String?
  // The member who asked for what Personal Agent Proxy did itself, as a plain id, so the entry
  // stays when they are gone; null for an agent's request.
  userId       String?
  // What went wrong, for a failed request: the api's kind of error, such as `credentials_rejected`,
  // and the provider's HTTP status after it where it answered with one, such as
  // `provider_unreachable 429`. None for every other outcome.
  error        String?

  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([taskId])
}

// What an agent set out to do with Personal Agent Proxy: an agent starts a task, naming it and
// saying what the person asked for, makes its requests for it, each logged with the task, and
// finishes it. Part of a task an agent hands to one of its sub-agents is a sub-task of it, so the
// tasks of one job form a tree. Plain ids, like the activity log, so it stays when the agent is
// gone.
model AgentTask {
  id         String    @id @default(cuid())
  orgId      String
  agentId    String
  // The agent's task this one was started for, as a sub-task (AgentTask); none for a task started
  // on its own.
  parentId   String?
  // A few words, as a heading.
  title      String
  // What the person asked for, in a sentence or two.
  goal       String
  via        AuditVia
  // Set once the agent calls the task finished; null while it is under way. Finishing a task
  // finishes its sub-tasks still under way too.
  finishedAt DateTime?
  // What was done or found, as the agent said when it finished, where it said; what a sub-task
  // handed back.
  outcome    String?
  // The member whose own the agent is, who alone sees the task; null for a shared agent's, which
  // everyone in the organization sees.
  ownerUserId String?

  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([agentId])
  @@index([parentId])
}

// What an agent told the makers of Personal Agent Proxy, such as a tool that didn't work as it
// expected: sent with the MCP server's send_feedback or the agent pages' feedback form, and read
// by us, never shown in the app. Plain ids, like the activity log, so it stays when the agent or
// the connection is gone; it goes with the organization.
model AgentFeedback {
  id           String   @id @default(cuid())
  orgId        String
  agentId      String
  // The agent's AGENT_PROVIDERS id, such as `claude`, kept beside the login it came from.
  providerId   String
  message      String
  // The connection and the tool it is about, where the agent named them.
  connectionId String?
  tool         String?
  via          AuditVia
  // The task the agent was on, where it named one.
  taskId       String?

  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([createdAt])
}

// An MCP client that registered itself to sign agents in, such as Claude or ChatGPT (OAuth
// Dynamic Client Registration). Anyone can register one; it gets nothing until a person signs in
// and lets it work as one of their agents. One that hasn't finished a sign-in a day after
// registering is deleted by the next registration.
model OAuthClient {
  // The client_id it signs in with.
  id           String    @id
  name         String
  redirectUris String[]
  // Only for a client that signs in with a secret; others have PKCE alone.
  secretHash   String?
  // When it first traded a code for tokens; kept for good once set.
  usedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  codes  OAuthCode[]
  grants OAuthGrant[]

  @@index([createdAt])
}

// A code a client exchanges once for tokens, within minutes, with its PKCE verifier. Only its
// SHA-256 is kept.
model OAuthCode {
  id            String   @id @default(cuid())
  codeHash      String   @unique
  clientId      String
  agentId       String
  // The member who signed the client in, as a plain id.
  userId        String
  redirectUri   String
  codeChallenge String
  expires       DateTime

  createdAt DateTime @default(now())

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  agent  Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([agentId])
}

// A client signed in as an agent: its access token and refresh token, by their SHA-256.
// Refreshing replaces both. Disconnecting it, revoking or deleting the agent, or the member who
// signed it in leaving the organization, ends it.
model OAuthGrant {
  id               String   @id @default(cuid())
  clientId         String
  agentId          String
  // The member who signed the client in, as a plain id, so the grant stays when they are gone:
  // they see and sign out their own clients on a shared agent, and leaving the organization signs
  // them out.
  userId           String
  accessTokenHash  String   @unique
  accessExpires    DateTime
  refreshTokenHash String   @unique
  refreshExpires   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  agent  Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([agentId])
  @@index([userId])
}
