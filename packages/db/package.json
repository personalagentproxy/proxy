{
	"name": "@proxy/db",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./agent": "./src/agent.ts",
		"./alerts": "./src/alerts.ts",
		"./audit": "./src/audit.ts",
		"./auth": "./src/auth.ts",
		"./chat": "./src/chat.ts",
		"./claude-account": "./src/claude-account.ts",
		"./connection": "./src/connection.ts",
		"./desktop-auth": "./src/desktop-auth.ts",
		"./feedback": "./src/feedback.ts",
		"./files": "./src/files.ts",
		"./harness": "./src/harness.ts",
		"./harness-transcript": "./src/harness-transcript.ts",
		"./vault": "./src/vault.ts",
		"./invitation": "./src/invitation.ts",
		"./instance-meta": "./src/instance-meta.ts",
		"./oauth": "./src/oauth.ts",
		"./organization": "./src/organization.ts",
		"./sandbox": "./src/sandbox.ts",
		"./task": "./src/task.ts",
		"./user": "./src/user.ts",
		"./viewer": "./src/viewer.ts",
		"./write-target": "./src/write-target.ts"
	},
	"scripts": {
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"db:dev": "bun --env-file=../../.env scripts/dev-db.ts",
		"db:generate": "prisma generate",
		"db:migrate:diff": "bun --env-file=../../.env prisma migrate diff --from-schema-datasource prisma/schema.prisma --to-schema-datamodel prisma/schema.prisma --script",
		"db:migrate:deploy": "bun --env-file=../../.env prisma migrate deploy"
	},
	"dependencies": {
		"@prisma/client": "^6.19.3",
		"@proxy/utils": "workspace:*",
		"prisma": "^6.19.3",
		"ts-results-es": "^7.1.0"
	},
	"devDependencies": {
		"@electric-sql/pglite": "0.4.3",
		"@prisma/dev": "0.25.2",
		"@types/bun": "latest",
		"typescript": "~6.0.2"
	}
}
