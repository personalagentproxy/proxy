# The local database `bun run dev` starts (Prisma's embedded Postgres). It holds one connection and
# skips prepared statements, so keep connection_limit=1&pgbouncer=true.
DATABASE_URL="postgres://postgres:postgres@127.0.0.1:51314/template1?sslmode=disable&connection_limit=1&pgbouncer=true"

# Where the web app and the api run.
APP_URL="http://localhost:5173"
VITE_PROXY_API_URL="http://localhost:4000"

# Hashes magic-link tokens. Any long random string in production (openssl rand -hex 32).
AUTH_SECRET="dev-only-secret"

# Encrypts connection credentials (app passwords, OAuth tokens). In production: openssl rand -base64 32.
# Changing it makes every stored credential unreadable, so connections have to be made again.
ENCRYPTION_KEY="ZGV2LW9ubHktZW5jcnlwdGlvbi1rZXktMzItYnl0ZXM="

# Google sign-in. Register http://localhost:4000/auth/google/callback as a redirect URI.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Production only: sending magic-link emails. Dev prints the link in the api's output instead.
# RESEND_KEY=""
# EMAIL_FROM=""

# Production only, when the app and api are sibling subdomains: the shared parent, e.g. ".example.com".
# SESSION_COOKIE_DOMAIN=""
